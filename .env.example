# ===========================================
# APLICACIÓN
# ===========================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===========================================
# AUTENTICACIÓN - Better Auth
# ===========================================
# Secret key para Better Auth (generar con: openssl rand -base64 32)
BETTER_AUTH_SECRET=your-secret-key-here

# URL base para Better Auth
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# ===========================================
# GOOGLE OAUTH
# ===========================================
# Obtener en: https://console.cloud.google.com/apis/credentials
# 1. Crear proyecto
# 2. Configurar pantalla de consentimiento OAuth
# 3. Crear credenciales OAuth 2.0
# 4. Agregar URLs autorizadas:
#    - Origen: http://localhost:3000
#    - Redirección: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===========================================
# BASE DE DATOS
# ===========================================
DATABASE_URL=postgresql://user:password@localhost:5432/jobby_db

# ===========================================
# EMAIL - Resend
# ===========================================
RESEND_API_KEY=re_xxxxxxxxxx

# ===========================================
# STORAGE - Vercel Blob
# ===========================================
BLOB_READ_WRITE_TOKEN=vercel_blob_token_here

# ===========================================
# MERCADO PAGO (Pagos)
# ===========================================
MERCADO_PAGO_ACCESS_TOKEN=your-mercadopago-token

# ===========================================
# SENTRY (Monitoreo de errores)
# ===========================================
SENTRY_AUTH_TOKEN=your-sentry-token
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn

# ===========================================
# INNGEST (Background Jobs)
# ===========================================
INNGEST_EVENT_KEY=your-inngest-key
INNGEST_SIGNING_KEY=your-inngest-signing-key

# ===========================================
# PRODUCCIÓN
# ===========================================
# En producción, cambiar:
# - NEXT_PUBLIC_APP_URL a tu dominio (ej: https://jobby.com)
# - BETTER_AUTH_URL a tu dominio
# - NEXT_PUBLIC_BETTER_AUTH_URL a tu dominio
# - Agregar en Google Console la URL de producción:
#   * Origen: https://tudominio.com
#   * Redirección: https://tudominio.com/api/auth/callback/google
