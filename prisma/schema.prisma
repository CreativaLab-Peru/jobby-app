generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TemporalUser {
  id    String   @id @default(uuid())
  email String   @unique
  name  String?
  date  DateTime @default(now())

  @@map("temporal_user")
}

// Usuarios registrados
model User {
  id                         String              @id @default(uuid())
  name                       String
  email                      String              @unique
  emailVerified              Boolean
  image                      String?
  updatedPassword            Boolean             @default(false)
  isBlocked                  Boolean             @default(false)
  lastLoginAt                DateTime?
  happensAfterPayment        Boolean             @default(false)
  acceptedTermsAndConditions Boolean             @default(false)
  acceptedTermsAt            DateTime?
  acceptedPrivacyPolicy      Boolean             @default(false)
  acceptedPrivacyPolicyAt    DateTime?
  acceptedCookiePolicy       Boolean             @default(false)
  acceptedSecurityPolicy     Boolean             @default(false)
  phoneNumber                String?
  acceptedSecurityPolicyAt   DateTime?
  birthday                   DateTime?
  createdAt                  DateTime
  updatedAt                  DateTime
  accounts                   Account[]
  cvs                        Cv[]
  logs                       LogEntry[]
  magicLinks                 MagicLinkToken[]
  sessions                   Session[]
  payments                   UserPayment[]
  verificationCode           VerificationCode[]
  userPreference             UserPreference[]
  userCreditBalance          UserCreditBalance[]
  Invoice                    Invoice[]
  complaints                 Complaint[]
  role                       UserRole            @default(USER)
  interviewSessions          InterviewSession[]
  cvPhotos                   CvPhoto[]
  routes                     Route[]
  roadmaps                   Roadmap[]

  @@map("user")
}

// Códigos de verificación para acciones como registro o recuperación de contraseña
model VerificationCode {
  id        String   @id @default(uuid())
  code      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("verification_code")
}

// Modelo requerido por Better Auth para OAuth y email verification
model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// Preferencias del usuario para búsqueda de empleo
model UserPreference {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  country String?

  // Cultura y Empresa
  targetIndustries String[] // Ej: ["Fintech", "Healthtech"] areas de interés
  preferredRoles   String[] // Ej: ["Senior Backend", "Tech Lead"] roles preferidos

  // Nivel y Modalidad
  expLevel         String? // Ej: "JUNIOR", "MID_LEVEL", "SENIOR", "LEAD", "DIRECTOR", "EXECUTIVE"
  workModality     String[] // Ej: ["REMOTE_ONLY", "HYBRID", "ONSITE_ONLY", "NO_PREFERENCE"]
  relocation       Boolean  @default(false)
  availability     String[] // Ej: ["IMMEDIATE", "ONE_MONTH", "TWO_MONTHS", "LISTENING_OFFERS"]
  opportunityTypes String[] // Ej: ["INTERNSHIP", "SCHOLARSHIP", "EXCHANGE_PROGRAM", "EMPLOYMENT"]

  // Skills y Tecnologías
  skills Json[]

  // Portfolio
  portfolioUrl String?

  // Logística del Match
  minSalary Decimal? @db.Decimal(12, 2)
  maxSalary Decimal? @db.Decimal(12, 2)
  currency  String   @default("USD")

  updatedAt DateTime @updatedAt

  // Preferencias de UI
  theme String @default("light") // "light" | "dark"

  @@map("user_preference")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model PaymentPlan {
  id          String      @id @default(uuid())
  slug        String      @unique
  name        String
  description String?
  paymentType PaymentType @default(ONE_TIME)

  // Pricing for Mercado Pago (Latin America - PEN)
  priceCentsPEN Decimal @db.Decimal(10, 2)
  // Pricing for Paddle (International - USD, with Paddle handling auto-conversion)
  priceCentsUSD Decimal @db.Decimal(10, 2)

  // Paddle integration
  paddleProductId  String?
  paddlePriceIdUSD String?

  features       Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  manualCvLimit  Int             @default(0)
  uploadCvLimit  Int             @default(0)
  payments       UserPayment[]
  creditPackages CreditPackage[]

  @@index([paddleProductId])
  @@index([paddlePriceIdUSD])
  @@map("subscription_plan")
}

model UserPayment {
  id            String      @id @default(uuid())
  userId        String
  planId        String
  startedAt     DateTime    @default(now())
  expiresAt     DateTime?
  active        Boolean     @default(true)
  manualCvsUsed Int         @default(0)
  uploadCvsUsed Int         @default(0)
  metadata      Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  plan          PaymentPlan @relation(fields: [planId], references: [id])
  user          User        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([planId])
  @@index([active])
  @@map("user_subscription")
}

model CvTemplate {
  id            String   @id // "harvard", "europass", "stem", "fullbright"
  name          String
  description   String?
  category      String // "professional", "european", "academic"
  isPremium     Boolean  @default(false)
  requiresPhoto Boolean  @default(false) // true para Europass
  isActive      Boolean  @default(true)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  cvs           Cv[]

  @@map("cv_template")
}

model CvPhoto {
  id        String   @id @default(uuid())
  userId    String
  url       String // URL pública de Cloudinary
  publicId  String // public_id de Cloudinary (para eliminar)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("cv_photo")
}

model Cv {
  id                String             @id @default(uuid())
  userId            String?
  createdByJobId    String?
  language          Language           @default(EN)
  status            JobStatus         @default(PENDING)
  opportunityType   OpportunityType
  cvType            CvType?
  title             String?
  templateId        String             @default("harvard")
  template          CvTemplate         @relation(fields: [templateId], references: [id])
  extractedJson     Json?
  fullTextSearch    String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  notes             String?
  attachments       Attachment[]
  user              User?              @relation(fields: [userId], references: [id])
  evaluations       CvEvaluation[]
  previews          CvPreview[]
  sections          CvSection[]
  opportunities     Opportunity[]
  queueJobs         QueueJob[]
  interviewSessions InterviewSession[]
  route             Route?

  @@index([userId])
  @@index([language])
  @@index([opportunityType])
  @@index([cvType])
  @@map("cv")
}

model Opportunity {
  id                   String
  cvId                 String
  routeId              String?
  title                String
  type                 OpportunityType
  deadline             DateTime?
  match                Decimal            @db.Decimal(8, 4)

  // requirements is deprecated, we will use requiredRequirements and optionalRequirements for matching and display purposes. However, we keep it here for legacy data and potential future use.
  requirements         String?
  requiredRequirements String[]
  optionalRequirements String[]

  linkUrl              String
  company              String?
  companyLogoUrl       String?
  location             String?
  modality             String?

  // Salary is deprecated, we will use minSalary and maxSalary from UserPreference for matching and display purposes. However, we keep it here for legacy data and potential future use.
  salary               String?
  minSalary            String?
  maxSalary            String?

  description          String?
  benefits             String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  cv                   Cv                 @relation(fields: [cvId], references: [id], onDelete: Cascade)
  route                Route?             @relation(fields: [routeId], references: [id], onDelete: Cascade)
  interviewSessions    InterviewSession[]
  roadmaps             Roadmap[]

  @@id([id, cvId])
  @@map("opportunity")
}

model InterviewSession {
  id            String @id @default(uuid())
  userId        String
  cvId          String
  opportunityId String

  // Metadatos de la sesión de Vapi
  vapiCallId String? @unique // Para vincular con el webhook
  status     String  @default("COMPLETED") // PENDING, COMPLETED, FAILED

  // KPIs / Resultados (Almacenados tras el webhook)
  overallScore Int? // 0-100
  confidence   Int? // 0-100 (Nivel de seguridad al hablar)
  clarity      Int? // 0-100 (Claridad técnica/explicativa)
  alignment    Int? // 0-100 (Qué tanto encaja con el rol)

  feedback   String? @db.Text
  transcript Json? // Guardamos la conversación final

  createdAt DateTime @default(now())

  // Relaciones
  user        User        @relation(fields: [userId], references: [id])
  cv          Cv          @relation(fields: [cvId], references: [id])
  // Nota: Dado que Opportunity tiene un ID compuesto en tu schema:
  opportunity Opportunity @relation(fields: [opportunityId, cvId], references: [id, cvId])

  @@index([userId])
  @@index([opportunityId, cvId])
  @@map("interview_session")
}

model CvSection {
  id          String        @id @default(uuid())
  cvId        String
  sectionType CvSectionType
  title       String?
  contentJson Json?
  order       Int           @default(0)

  isVisible   Boolean       @default(true) // Crucial para la feature
  isRecommended Boolean     @default(false) // Meta-dato para UI

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  cv          Cv            @relation(fields: [cvId], references: [id])

  @@index([cvId, sectionType])
  @@index([cvId, order])
  @@map("cv_section")
}

model CvEvaluation {
  id               String            @id @default(uuid())
  cvId             String
  startedAt        DateTime          @default(now())
  finishedAt       DateTime?
  status           JobStatus         @default(PENDING)
  overallScore     Float?
  summary          String?
  extractorOutput  Json?
  improvementsJson Json? // AI-generated improved texts per section
  createdByJobId   String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  cv               Cv                @relation(fields: [cvId], references: [id])
  scores           EvaluationScore[]
  recommendations  Recommendation[]

  @@index([cvId])
  @@index([status])
  @@index([createdAt])
  @@map("cv_evaluation")
}

model EvaluationScore {
  id           String        @id @default(uuid())
  evaluationId String
  sectionType  CvSectionType
  score        Float
  confidence   Float?
  detailsJson  Json?
  createdAt    DateTime      @default(now())
  evaluation   CvEvaluation  @relation(fields: [evaluationId], references: [id])

  @@index([evaluationId, sectionType])
  @@map("evaluation_score")
}

model Recommendation {
  id           String         @id @default(uuid())
  evaluationId String
  sectionType  CvSectionType?
  text         String
  severity     String?
  metadata     Json?
  createdAt    DateTime       @default(now())
  evaluation   CvEvaluation   @relation(fields: [evaluationId], references: [id])

  @@index([evaluationId])
  @@map("recommendation")
}

model CvPreview {
  id           String   @id @default(uuid())
  cvId         String
  snapshotHtml String?
  snapshotJson Json?
  createdAt    DateTime @default(now())
  createdBy    String?
  note         String?
  cv           Cv       @relation(fields: [cvId], references: [id])

  @@index([cvId, createdAt])
  @@map("cv_preview")
}

model Attachment {
  id        String   @id @default(uuid())
  cvId      String
  filename  String
  mimeType  String?
  url       String
  size      Int?
  createdAt DateTime @default(now())
  cv        Cv       @relation(fields: [cvId], references: [id])

  @@index([cvId])
  @@map("attachment")
}

model QueueJob {
  id          String    @id @default(uuid())
  jobId       String    @unique
  type        String
  payload     Json
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  lastError   String?
  startedAt   DateTime?
  finishedAt  DateTime?
  cvId        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  cv          Cv?       @relation(fields: [cvId], references: [id])

  @@index([status])
  @@index([type])
  @@index([cvId])
  @@map("queue_job")
}

model MagicLinkToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  purpose   String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  usedByIp  String?
  usedByUa  String?
  metadata  Json?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("magic_link_token")
}

// Balance de créditos del usuario
model UserCreditBalance {
  id        String            @id @default(uuid())
  userId    String
  amount    Int               @default(0) // Usamos Int para evitar problemas de coma flotante
  type      CreditBalanceType
  updatedAt DateTime          @updatedAt
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  creditTransaction CreditTransaction[]

  @@unique([userId, type])
  @@map("user_credit_balance")
}

// Registro de transacciones de créditos (recargas y consumos)
model CreditTransaction {
  id          String            @id @default(uuid())
  balanceId   String
  amount      Int // Positivo para recargas, negativo para consumos
  type        TransactionType
  description String?
  metadata    Json? // Para guardar ID de pago de Stripe o ID de CV generado
  createdAt   DateTime          @default(now())
  balance     UserCreditBalance @relation(fields: [balanceId], references: [id])

  @@index([balanceId])
  @@map("credit_transaction")
}

// Créditos disponibles por plan o paquete
model CreditPackage {
  id         String            @id @default(uuid())
  code       String
  name       String // Ej: "Pack Pro IA"
  credits    Int // Cantidad de créditos que otorga
  priceCents Int // Siempre en centavos para evitar redondeos: 1000 = $10.00
  currency   String            @default("USD")
  active     Boolean           @default(true)
  type       CreditBalanceType // A qué tipo de saldo se aplica
  planId     String? // Plan al que pertenece este paquete, null = sin plan asociado
  createdAt  DateTime          @default(now())

  plan    PaymentPlan? @relation(fields: [planId], references: [id])
  invoice Invoice[]

  @@index([planId])
  @@map("credit_package")
}

// Facturas de pagos realizados por usuarios
model Invoice {
  id           String        @id @default(uuid())
  userId       String
  amountTotal  Int // Total pagado en centavos
  currency     String
  status       PaymentStatus @default(PENDING)
  provider     String // "STRIPE", "PAYPAL"
  providerTxId String?       @unique // ID externo de la pasarela

  // Relaciones opcionales (un pago puede ser por un plan O por un paquete)
  planId    String?
  packageId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User           @relation(fields: [userId], references: [id])
  package CreditPackage? @relation(fields: [packageId], references: [id])

  @@map("invoice")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// Complaints Book
model Complaint {
  id        String   @id @default(uuid())
  userId    String
  name      String
  email     String
  phone     String?
  complaint String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("complaint")
}

model LogEntry {
  id        String    @id @default(uuid())
  userId    String?
  email     String?
  action    LogAction
  entity    String?
  entityId  String?
  level     LogLevel  @default(INFO)
  message   String
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())
  user      User?     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
  @@index([level])
  @@map("log_entry")
}

// Ruta guiada del usuario (agrupa CV → Análisis → Oportunidades)
model Route {
  id        String      @id @default(uuid())
  userId    String
  cvId      String?     @unique // 1:1 con CV, nullable hasta que se cree
  name      String
  status    RouteStatus @default(CV_PENDING)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  cv            Cv?           @relation(fields: [cvId], references: [id])
  opportunities Opportunity[]
  roadmaps      Roadmap[]

  @@index([userId])
  @@index([userId, isActive])
  @@map("route")
}

// Roadmap generado por IA para una oportunidad específica
model Roadmap {
  id             String    @id @default(uuid())
  userId         String
  cvId           String
  opportunityId  String
  routeId        String    @unique
  status         JobStatus @default(PENDING)
  title          String?
  summary        String?   @db.Text
  createdByJobId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity   @relation(fields: [opportunityId, cvId], references: [id, cvId], onDelete: Cascade)
  route       Route         @relation(fields: [routeId], references: [id], onDelete: Cascade)
  steps       RoadmapStep[]

  @@unique([opportunityId, cvId, userId, routeId])
  @@index([userId])
  @@index([cvId])
  @@map("roadmap")
}

// Paso individual del roadmap
model RoadmapStep {
  id          String @id @default(uuid())
  roadmapId   String
  order       Int // Seguirá el orden 1-4 de los bloques base [cite: 32]
  title       String // Ejemplo: "Define tu perfil/proyecto" [cite: 33]
  description String @db.Text

  // Datos dinámicos del sistema inteligente
  actionItems    Json // Array de strings (Máximo 3 tareas) [cite: 39, 50]
  sourceInsights Json? // Array de strings (Máximo 3 datos reales del programa)

  // Comparativa de competitividad
  exampleWeak   String? @db.Text // Perfil débil [cite: 42, 53]
  exampleStrong String? @db.Text // Perfil competitivo [cite: 42, 53]

  // Metadatos para IA y Matching
  tags String[] // Categorías: ielts, leadership, mvp, etc. [cite: 43, 54]

  // Configuración y recursos
  estimatedDays Int?
  resources     Json? // Array de { title, url, type }
  isFree        Boolean @default(false)

  createdAt DateTime @default(now())
  roadmap   Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@index([roadmapId, order])
  @@map("roadmap_step")
}

model CvSectionConfiguration {
  id              String          @id @default(cuid())
  cvType          CvType
  opportunityType OpportunityType

  // Almacenaremos el JSON que me pasaste aquí
  // Usamos Json de Prisma para consultas eficientes y tipado
  sections        Json

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([cvType, opportunityType]) // Un solo esquema por combinación
  @@map("cv_section_configuration")
}

enum RouteStatus {
  CV_PENDING
  CV_CREATED
  ANALYSIS_PENDING
  ANALYSIS_DONE
  OPPORTUNITIES_PENDING
  OPPORTUNITIES_DONE
  ROADMAP_PENDING
  ROADMAP_IN_PROGRESS
  ROADMAP_DONE
  PROGRAM_PENDING
  PROGRAM_IN_PROGRESS
  PROGRAM_DONE
}

enum CreditBalanceType {
  AI_ACTIONS // Créditos para acciones con IA
  UPLOADS // Créditos para subir CVs
  MANAGE_CVS // Créditos para gestionar CVs
  SEARCH_OPPORTUNITIES // Créditos para buscar oportunidades
}

enum TransactionType {
  RECHARGE // Compra de créditos
  CONSUMPTION // Gasto por usar la IA
  REFUND // Devolución por error en proceso
  BONUS // Regalo por registro o promoción
}

/// ---------- Enums ----------
enum Language {
  EN
  ES
}

enum PaymentType {
  SUBSCRIPTION
  ONE_TIME
  REFUND
  FREE
}

enum OpportunityType {
  INTERNSHIP
  SCHOLARSHIP
  EXCHANGE_PROGRAM
  EMPLOYMENT
  STARTUP
}

enum CvType {
  TECHNOLOGY_ENGINEERING
  DESIGN_CREATIVITY
  MARKETING_STRATEGY
  MANAGEMENT_BUSINESS
  FINANCE_PROJECTS
  SOCIAL_MEDIA
  EDUCATION
  SCIENCE
}

enum CvSectionType {
  SUMMARY
  EXPERIENCE
  EDUCATION
  SKILLS
  PROJECTS
  VOLUNTEERING
  CERTIFICATIONS
  LANGUAGES
  CONTACT
  COMPLEMENTS
  ACHIEVEMENTS
  INTERESTS
}

enum JobStatus {
  PENDING
  IN_PROGRESS
  SUCCEEDED
  FAILED
  CANCELLED
}

enum LogAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PAYMENT
  EVALUATION
  JOB
  EMAIL
  FILE_UPLOAD
  AUTH
  OPPORTUNITY
  OTHER
}

enum LogLevel {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum UserRole {
  USER
  ADMIN
}
